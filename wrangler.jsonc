{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opensisakhk",
  // henryaisoft@gmail.com account. Pinned so a wrangler login to another account cannot deploy elsewhere.
  "account_id": "43b0670039d0868f68ab4dd61e923ae3",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opensisakhk",
      "database_id": "462ae1f5-9002-4628-a342-cdcb68065591",
      "migrations_dir": "migrations"
    }
  ],
  // Login attempts (src/worker/index.ts): per IP generous enough for a whole class behind the school's NAT,
  // per SIS username / student strict enough to stop password guessing.
  "ratelimits": [
    { "name": "LOGIN_IP_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "LOGIN_USER_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  // Watch the public school timetable for rewrites (SIS reshuffles it late at night).
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "GITHUB_REPO": "oondraa/OpenSISAKHK" },
  "observability": { "enabled": true }
}
