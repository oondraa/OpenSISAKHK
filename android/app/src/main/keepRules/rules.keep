# R8 rules for the release build (AGP combines every file in src/main/keepRules).

# WorkManager creates its Room database by reflection (WorkDatabase_Impl's no-argument constructor).
-keep class * extends androidx.room.RoomDatabase { <init>(); }

# kotlinx.serialization: the worker's JSON is read through the generated serializers of the data classes.
-keepattributes *Annotation*, InnerClasses
-keepclassmembers @kotlinx.serialization.Serializable class io.github.oondraa.opensisakhk.** {
    *** Companion;
    static ** INSTANCE;
    kotlinx.serialization.KSerializer serializer(...);
}
-keep,includedescriptorclasses class io.github.oondraa.opensisakhk.**$$serializer { *; }
-keepclassmembers class io.github.oondraa.opensisakhk.**$Companion {
    kotlinx.serialization.KSerializer serializer(...);
}
